# Copia este archivo como .env y ajusta los valores
PORT=3000
NODE_ENV=development

# Conexión PostgreSQL (elige UNA forma)
DATABASE_URL=postgresql://pit_app:pit_app_2026@localhost:5432/pit_itver
# PGHOST=localhost
# PGPORT=5432
# PGUSER=pit_app
# PGPASSWORD=pit_app_2026
# PGDATABASE=pit_itver

# Seguridad JWT: usa una cadena aleatoria larga (mín. 32 caracteres)
# Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-cadena-aleatoria-de-al-menos-32-caracteres
JWT_EXPIRES_IN=8h

# Reglas institucionales
DOMINIO_INSTITUCIONAL=veracruz.tecnm.mx
PERIODO_ACTUAL=2026-2
TZ_INSTITUCIONAL=America/Mexico_City

# Solo si sirves el frontend desde otro origen (p.ej. Live Server en :5500)
CORS_ORIGIN=
